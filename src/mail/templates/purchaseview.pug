        font-style: italic;
      }
      .description {
        color: black;
        font-size: 16px;
        text-align: center;
        margin-left: 1rem;
        margin-right: 1rem;
        margin-bottom: 2rem;
        line-height: 2px;
        white-space: nowrap;
      }
      h2 {
        color: #5f0404;
        font-size: 26px;
        text-align: center;
        font-style: italic;
      }
      p {
        color: black;
        font-size: 15px;
        text-align: center;
      }
      b {
        color: #CA0B0B;
        font-weight: bold;
      }
      span {
        font-weight: bold;
      }
      h3 {
        color: #CA0B0B;
        font-size: 20px;
        text-align: center;
      }
      h4 {
        color: #CA0B0B;
        font-size: 20px;
        text-align: center;
        margin-bottom: 0;
        font-weight: bold;
        line-height: 0.3px;
      }
      .footer {
        text-align: center;
        margin: auto;
        padding: 20px;
        align-items: center;
        background: linear-gradient(to bottom, transparent, #eeeeee);
        font-size: 12px;
      }
      .social-icons img {
        width: 40px;
        margin: 0 5px;
      }
      .store-icons img {
        width: 180px;
        margin: 0 5px;
      }
      .products {
        width: 60%;
        margin: 0 10px 0 0;
        justify-content: space-between;
      }
      .product-item {
        border: 2px solid black;
        border-radius: 15px;
        padding: 5px;
        align-items: center;
        margin-bottom: 15px;
      }
      .product-item img {
        width: 50%;
        height: auto;
      }
      .product-item h2 {
        color: #CA0B0B;
        font-size: 20px;
        text-align: center;
        font-style: italic;
      }
      .product-item P {
        color: black;
        font-size: 16px;
        text-align: center;
        font-style: italic;
      }
      .order-container {
        display: flex;
        height: 100%;
        margin-top: 2rem;
      }
      .order-summary {
        border: 2px solid black;
        height: auto;
        margin: auto;
        border-radius: 30px;
        width: 60%;
      }
      .next {
        padding: 20px;
        background: white;
        box-shadow: 0 15px 55px rgba(0, 0, 0, 0.2);
      }
      .next h2 {
        color: #ca0b0b;
        font-size: 22px;
        font-style: italic;
        text-align: center;
      }
      .next img {
        width: 100%;
        max-width: 100%;
        height: auto;
      }

