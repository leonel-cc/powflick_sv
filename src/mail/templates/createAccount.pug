doctype html
html(lang='en')
    head
        meta(charset='utf-8')
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Welcome to Pow Flick!
        style.
            body {
                font-family: Arial, sans-serif;
                margin: 0;
                padding: 0;
                background: url('https://back-nu-ashy.vercel.app/TheSportsLogo.png') no-repeat top;
                background-size: fill;
                width:100%
            }
           .header {
                position: relative;
                z-index: 0;
                display: flex;
                justify-content:center;
                align-items:center;
                width: 100%;
            }
            .container {
                max-width: 800px;
                margin: 2px auto 2px auto;
                text-align: center;
                overflow: hidden;
            }
            .inner-container {
                text-align: center;
                background-color: #eeeeee;
            }
            .title {
                margin-bottom: 20px;
                color: white;
                padding: 32px 0 0 0;
                font-size: 26px;
                height: 60px;
                text-align: center;
                font-weight: bold;
                background: url('https://back-nu-ashy.vercel.app/Welcome.png') no-repeat center;
                background-size: cover;
                box-shadow: 0 15px 55px rgba(0, 0, 0, 0.2);
                font-style: italic;
            }
            .contain { padding: 40px 40px; }
            h2 { color: #cc0000; font-size: 24px; margin-bottom: 10px; }
            p { color: black; font-size: 12px; text-align: center; }
            .btn { background: #cc0000; color: white; padding: 15px 25px; text-decoration: none; font-weight: bold; border-radius: 5px; display: inline-block; margin: 20px 0; }
            .footer { max-width: 600px; margin: auto; text-align: center; font-size: 12px; color: gray; margin-top: 20px; }
            .social-icons img { width: 24px; margin: 0 5px; }
            .img-wrapper { position: relative; text-align: center; }
            .text-image {
                position: absolute; 
                top: 50%; 
                left: 50%; 
                transform: translate(-50%, -50%);
                margin: 0;
                font-size: 24px;
            }
    
    body
        div(style='height:130px')
        .container
            .inner-container
                .title Welcome!
                .contain
                    img(src='https://back-nu-ashy.vercel.app/EMAILS_SPORTS_WELCOME.png', style='max-width:100%;')
                    h2 Hello, #{firstname}!
                    p Your new account has been successfully registered. We are thrilled to have you as part of the Pow Flick community!
                    p Log in to your account and start exploring custom uniform ideas tailored to your team’s identity.
                    a.btn(href='https://powflick.com/dashboard/profile') Go to my Account

            .footer
                p(style="color: #cc0000;") Thank you for choosing Pow Flick. Customize Your Identity!
                p Please do not reply to this email. For any inquiries, contact our support team.
                p
                    a(href="https://play.google.com")
                        img(src="https://back-nu-ashy.vercel.app/googleplay.png", style="width:120px; margin-right: 40px;")
                    a(href="https://apps.apple.com")
                        img(src="https://back-nu-ashy.vercel.app/appstore.png", style="width:120px;")
                .social-icons
                    a(href="#")
                        img(src="https://back-nu-ashy.vercel.app/instagram.png")
                    a(href="#")
                        img(src="https://back-nu-ashy.vercel.app/pinterest.png")
                    a(href="#")
                        img(src="https://back-nu-ashy.vercel.app/facebook.png")
                p You can email us at powflick@gmail.com or call us at +86 15920100486. Your headquarters are at B15-280, Xia Nan Yi Heng Base Section, Guicheng Subdistrict, Nanhai District, Foshan City, Guangdong Province, China.