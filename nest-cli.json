{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {"include": "./mail/templates", "outDir": "./dist"},
      {"include": "./pdf/fonts", "outDir": "./dist"},
      {"include": "./public/*.png", "outDir": "./dist"}
    ],
    "watchAssets": true,
    "deleteOutDir": true
  }
}