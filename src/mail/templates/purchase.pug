doctype html
html(lang='en')
    head
        meta(charset='utf-8')
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title New Purchase.
    <header style='text-align:center; padding-top:4vh; padding-bottom:4vh; background-color:white;'>
        <img src='cid:headerTheSportsLogo' style='max-width:100%; align-content:center;'/>
    </header>
    body
    <article style='border-bottom:solid #cc0000; padding-bottom:2vh;'>
        <h2 style='color: #cc0000; text-align:left'>Hello #{name}!</h2>
        <p style='color:black; text-align:left'>We notify you that your purchase on our platform was successfully completed.</p>
        <p style='color:black; text-align:left'>Thank you for trusting our products and services. Below, you can see more details of the transaction and the order.</p>
        ul
            each product in products
                .row
                    .col-md-4(style='display: flex; align-items: center;')
                        img(src=product.imageURL, alt=product.productName, style='width: auto; height: 171px; margin-right: 10px;')
                        div(style='color:black; text-align:left;')
                            p(style='margin-bottom: 5px;') <b>Product:</b> #{product.productName}
                            p(style='margin-bottom: 5px;') <b>Quantity:</b> #{product.amount}
                                each customization in product.customizationData
                                    p(style='margin-bottom: 5px;') <b>##{customization.index}:</b> BackName: #{customization.text} | Number: #{customization.number}

                            p(style='margin-bottom: 5px;') <b>Price:</b> #{currencySymbol}#{product.price}
        p(style='color:black; text-align:left') <b>Total value:</b> #{currencySymbol}#{total}
        if cuotes
            p(style='color:black; text-align:left') Payment plan: #{cuotes} installments of #{currencySymbol}#{cuotesValue}
        p(style='color:black; text-align:left') <b>Purchase date:</b> #{purchaseDate}
    </article>
    <article style='border-bottom:solid #cc0000; padding-bottom:2vh;'>
        div(style='display: flex; width: full; flex-direction: row; justify-content: space-between; align-items: center; height: 100%;')
            div(style='flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;')
                div(style='flex: 1; margin: auto')
                    p(style='color:black; text-align:left;') <b>User data:</b>
                div(style='flex: 1; margin: auto; padding-left: 5px;')
                    p(style='color:black; text-align:left') <b>Name:</b> #{user.firstName} #{user.lastName}
                    p(style='color:black; text-align:left') <b>Email:</b> #{user.email}
                    p(style='color:black; text-align:left') <b>Phone:</b> #{user.phone}
            div(style='flex: 1; display: flex; flex-direction: column; align-items: center')
                div(style='flex: 1; margin: auto; padding-left: 20px;')
                    p(style='color:black; text-align:left;') <b>Shipping address:</b>
                div(style='flex: 1; margin: auto; padding-left: 5px;')
                    p(style='color:black; text-align:left') <b>Country:</b> #{direction.country}
                    p(style='color:black; text-align:left') <b>City:</b> #{direction.city}
                    p(style='color:black; text-align:left') <b>District:</b> #{direction.district}
                    p(style='color:black; text-align:left') <b>Address:</b> #{direction.address}
                    p(style='color:black; text-align:left') <b>Neighborhood:</b> #{direction.neighborhood}
                    p(style='color:black; text-align:left') <b>Postal code:</b> #{direction.postalCode}
                    if direction.addressReference
                        p(style='color:black; text-align:left') <b>Reference:</b> #{direction.addressReference}

    </article>
    footer
        <p style='color:black; text-align:left'>Do not reply to this sender</p>
        <p style='color:black; text-align:left'><b>Sincerely:</b> The <span style="color: #cc0000"><b>Pow Flick</b></span> Team</p>
