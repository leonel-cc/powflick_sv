doctype html
html(lang='es')
    head
        meta(charset='utf-8')
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title ¡You have requested to recover your password!
    <header style='text-align:center; padding-top:4vh; padding-bottom:4vh; background-color:white;'>
        <img src='https://back-nu-ashy.vercel.app/TheSportsLogo.png' style='max-width:100%; align-content:center;'/>
    </header>
    body
    <article style='border-bottom:solid #cc0000; padding-bottom:2vh;'>
        <h2 style='color: #cc0000; text-align:left'>¡Hi #{name}!</h2>
        <h4 style='color:black; text-align:left'>¡Just one step closer!</h4>
        <p style='color:black; text-align:left'>We have received a request to change your password.</p>
        <p style='color:black; text-align:left'>You just have to click on the link</p>
        p(style='text-align:center; margin:4vh 0 4vh 0') <a href=#{link} style='padding:2vh; color:#cc0000;'>Recover password.</a>
